# PostgreSQL connection used by the web app, the worker and migrations
DATABASE_URL=postgres://luora:luora@localhost:5432/luora

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts marketplace and carrier credentials stored in the database. Do not lose it.
ENCRYPTION_KEY=

# Public URL of the app. Used for the Allegro OAuth redirect and webhook URLs.
APP_URL=http://localhost:3000

# "live" talks to the real APIs. "mock" uses fake orders and labels so you can try the app without credentials.
INTEGRATIONS_MODE=mock

# How often the worker pulls new orders from every marketplace account
SYNC_INTERVAL_MINUTES=3

# First admin account, created by `pnpm db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
